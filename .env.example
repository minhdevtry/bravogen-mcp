# ========================================================
# BravoGen MCP Server - Environment Configuration
# ========================================================

# Base URL của máy chủ BravoGen nội bộ
BRAVOGEN_BASE_URL=https://chat.bravogen.io.vn

# Cách 1: Cấu hình tài khoản đơn lẻ
BRAVOGEN_USERNAME=your_username
BRAVOGEN_PASSWORD=your_password

# Cách 2: Cấu hình đa tài khoản (danh sách user:pass phân cách bằng dấu phẩy)
# BRAVOGEN_ACCOUNTS="user1:pass1,user2:pass2,user3:pass3"

# Hoặc chuỗi JSON đa tài khoản:
# BRAVOGEN_ACCOUNTS='[{"id":"acc1","username":"u1","password":"p1"},{"id":"acc2","username":"u2","password":"p2"}]'

# Tự động chờ khi chạm Rate Limit (mặc định: true)
BRAVOGEN_AUTO_WAIT=true
BRAVOGEN_MAX_WAIT_SECONDS=90
